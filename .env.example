# Required: replace placeholders locally; never commit the populated file.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
# Secure cookies default to true. Use false ONLY for a local HTTP demonstration.
SESSION_COOKIE_SECURE=false
# Optional contact address used by public OpenAlex requests.
OPENALEX_MAILTO=
# Provisioning only: an absolute private path OUTSIDE the checkout.
# DEMO_CREDENTIALS_FILE=/private/path/researchx-demo-credentials.json
